# ===============================================================
# Configuración de Claves de API Gratuitas para LLMs
# Copia este archivo como .env y añade tus claves (sin comillas)
# NUNCA compartas ni subas tu archivo .env al repositorio
# ===============================================================

# 1. Groq (Recomendado: ultra rápido para trading en tiempo real)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini / AI Studio (Recomendado: contexto de 1M tokens)
# Obtén tu clave gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OpenRouter (Recomendado: múltiples modelos con sufijo :free)
# Obtén tu clave gratis en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. Mistral AI (Excelente para razonamiento y código)
# Obtén tu clave gratis en: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# 5. Cohere (1,000 llamadas gratis/mes, análisis de texto)
# Obtén tu clave gratis en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
